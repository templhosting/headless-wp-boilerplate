# Copy to .env to override the dev stack defaults.
#
# The host port the site is served on. It is also the port Apache listens on
# inside the container, because home_url() carries the port and loopback
# requests have to resolve the same URL. Changing it after the site is
# installed means `composer dev:reset`, since home_url is stored in the
# database.
TEMPL_HEADLESS_PORT=8080

# Set to 1 to provision a subdirectory multisite network instead of a single
# site. Prefer the wrapper scripts, which set this for you and reprovision from
# an empty database (switching mode requires it):
#   composer dev:up:multisite / composer dev:reset:multisite
# TEMPL_HEADLESS_MULTISITE=0

# The sample subsite created under multisite. Read only while provisioning, so
# changing either after the network exists means `composer dev:reset:multisite`.
# SAMPLE_SITE_SLUG=customer-one
# SAMPLE_SITE_TITLE=Customer One
