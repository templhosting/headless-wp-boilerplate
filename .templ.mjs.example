// Templ deploy configuration. Copy to .templ.mjs and fill in the real app id,
// host and port from the Templ panel (Website > Overview > SFTP/SSH).
// .templ.mjs is gitignored because it names real servers; only this example is
// committed.
//
// What ships is the wp-content overlay -- mu-plugins, plugins and the theme --
// and nothing else. WordPress core, uploads and wp-config.php live on the
// server and are never touched by a deploy, which is the same contract the dev
// stack keeps: this repo owns wp-content and only wp-content.
//
// Usage (always `pnpm run deploy`; bare `pnpm deploy` is a reserved builtin,
// and flags need the `--` separator so pnpm passes them through):
//   pnpm run deploy production
//   pnpm run deploy                 # target defaults to the current git branch
//   pnpm run deploy production -- --dry     # print the commands, run nothing
//   pnpm run deploy production -- --delete  # remove server files absent from here

const config = {
	options: {
		// The tree that gets rsynced. Everything under it lands inside the
		// target's dst directory.
		dir: 'wp-content',

		// Never let a deploy carry local cruft onto a server.
		exclude: [
			'.DS_Store',
			'*.log',
			// Feature plugins keep no vendor tree of their own, but exclude it
			// defensively so a stray composer install cannot bloat a deploy.
			'**/node_modules',
			'**/vendor',
		],
	},

	templs: {
		production: {
			// From the Templ panel. The app id is the only thing most targets
			// need: `user` defaults to `user_<app>` and `dst` to `app_<app>/`.
			app: 1234,
			host: 'sweden1.templssh.com',
			// Templ assigns a high port per site. It is never 22, so copy it
			// from the panel: leaving it out sends the connection to 22, where
			// it fails rather than falling back to anything useful.
			port: 12345,

			// Land the overlay in the live wp-content.
			//
			// {{app_dir}} expands to the bare app id, not to `app_<id>`, so the
			// `app_` prefix has to be written out. The name reads like it
			// includes it; it does not.
			dst: 'app_{{app_dir}}/public/wp-content',

			// Optional: a specific private key, when the agent or CI cannot use
			// the default ~/.ssh identity.
			// sshId: '~/.ssh/id_ed25519_templ',

			// Runs on the server after the files are in place, from inside dst
			// -- so the working directory is wp-content, not the webroot.
			// WP-CLI walks up to find wp-config.php, so plain `wp` works here.
			//
			// Activating is idempotent and cheap, and it is what makes a first
			// deploy self-sufficient: the MU plugin lands in the same rsync, so
			// the feature plugins find their dependency already present.
			//
			// This is the single-site form. A multisite target needs --network:
			//   wp plugin activate templ-contact-form templ-newsletter --network && wp rewrite flush --hard
			sshCmd: 'wp plugin activate templ-contact-form templ-newsletter && wp rewrite flush --hard',
		},

		// A second target, reached with `pnpm run deploy staging`.
		staging: {
			app: 5678,
			host: 'sweden1.templssh.com',
			port: 12346,
			dst: 'app_{{app_dir}}/public/wp-content',
			sshCmd: 'wp plugin activate templ-contact-form templ-newsletter && wp rewrite flush --hard',
		},
	},
};

export default config;
